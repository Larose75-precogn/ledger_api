              "evenement": "Créance constatée (remboursement assurance à recevoir)",
              "debit": "462",
              "credit": "708 ou 772"
            },
            {
              "evenement": "Encaissement de la créance",
              "debit": "5xx (banque)",
              "credit": "462"
            }
          ]
        },
        {
          "compte": "470",
          "intitule": "Comptes d'attente — à affecter",
          "usage": "Mouvement non encore identifié. Doit être soldé avant clôture. Un 470 ouvert en fin d'exercice est une erreur.",
          "ecritures": [
            {
              "evenement": "Entrée banque non identifiée",
              "debit": "5xx (banque)",
              "credit": "470"
            },
            {
              "evenement": "Sortie banque non identifiée",
              "debit": "470",
              "credit": "5xx (banque)"
            }
          ]
        }
      ]
    },
    {
      "classe": "5",
      "intitule": "Comptes financiers — banque et caisse",
      "comptes": [
