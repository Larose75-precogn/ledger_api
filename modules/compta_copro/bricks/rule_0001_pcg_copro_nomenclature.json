{
  "id": "R-PCG-COPRO-0001",
  "type": "Rule",
  "title": "Plan comptable des syndicats de copropriétaires",
  "description": "Nomenclature comptable applicable à tout syndicat de copropriétaires, issue de l'arrêté du 14 mars 2005. Chaque compte est décrit avec son usage et ses écritures types selon le sens du mouvement (débit ou crédit), afin de permettre la suggestion de contrepartie sans table codée en dur. Les numéros de sous-comptes spécifiques (451:NOM, 401:NOM, comptes bancaires) sont définis dans le BYOS de l'organisation.",
  "source": "Arrêté du 14 mars 2005 relatif aux comptes du syndicat des copropriétaires — https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000000258165",
  "owner": "module:structory:compta_copro",
  "language": "fr",
  "version": "3",
  "status": "Active",
  "tags": [
    "pcg",
    "copropriete",
    "reglementaire",
    "nomenclature"
  ],
  "principe": "Aucune compensation entre comptes débiteurs et créditeurs. Classe 1 = fonds propres. Classes 4-5 = tiers et banque. Classes 6-7 = charges et produits. La contrepartie naturelle dépend du sens : un même compte débité ou crédité n'a pas la même contrepartie.",
  "comptes": [
    {
      "classe": "1",
      "intitule": "Fonds propres, provisions et financements long terme",
      "comptes": [
        {
          "compte": "102",
          "intitule": "Provisions pour charges",
          "usage": "Fonds votés en AG pour dépenses futures identifiées (gros travaux). Distinct de 701 (charges courantes annuelles).",
          "ecritures": [
            {
              "evenement": "Appel de fonds pour travaux futurs",
              "debit": "451:NOM",
              "credit": "102"
            },
            {
              "evenement": "Utilisation du fonds pour travaux",
              "debit": "102",
              "credit": "5xx (banque travaux)"
            }
          ]
        },
        {
          "compte": "103",
          "intitule": "Avances — fonds de roulement",
          "usage": "Avances permanentes des copropriétaires pour la trésorerie courante. Restituables à la vente du lot.",
          "ecritures": [
            {
              "evenement": "Versement de l'avance par le copropriétaire",
              "debit": "5xx (banque)",
              "credit": "103"
            },
            {
              "evenement": "Restitution au copropriétaire (vente)",
              "debit": "103",
              "credit": "5xx (banque)"
            }
          ]
        },
        {
          "compte": "104",
          "intitule": "Travaux votés non encore réalisés",
          "usage": "Engagement pluriannuel voté en AG, dépense reportée sur exercice futur.",
          "ecritures": [
            {
              "evenement": "Engagement de travaux votés en AG",
              "debit": "451:NOM",
              "credit": "104"
            },
            {
              "evenement": "Réalisation des travaux (bascule en charge)",
              "debit": "104",
              "credit": "671"
            }
          ]
        },
        {
          "compte": "105",
          "intitule": "Fonds de travaux ALUR (compte séparé obligatoire)",
          "usage": "Fonds obligatoire depuis loi ALUR 2014, min 5% du budget annuel. Non restituable à la vente. Compte bancaire dédié.",
          "ecritures": [
            {
              "evenement": "Alimentation du fonds (appel de fonds ALUR)",
              "debit": "451:NOM",
              "credit": "105"
            },
            {
              "evenement": "Utilisation pour travaux",
              "debit": "105",
              "credit": "5xx (banque fonds travaux)"
            }
          ]
        },
        {
          "compte": "12",
          "intitule": "Résultat de l'exercice",
          "usage": "Solde charges/produits en fin d'exercice. Objectif = zéro. Excédent remboursé ou reporté, déficit appelé.",
          "ecritures": [
            {
              "evenement": "Clôture avec excédent (produits > charges)",
              "debit": "7xx (solde produits)",
              "credit": "12"
            },
            {
              "evenement": "Clôture avec déficit (charges > produits)",
              "debit": "12",
              "credit": "6xx (solde charges)"
            }
          ]
        }
      ]
    },
    {
      "classe": "4",
      "intitule": "Copropriétaires et tiers",
      "comptes": [
        {
          "compte": "401",
          "intitule": "Fournisseurs — factures à payer",
          "usage": "Dette envers un prestataire. Sous-compte par fournisseur : 401:NOM_FOURNISSEUR.",
          "ecritures": [
            {
              "evenement": "Facture reçue d'un fournisseur",
              "debit": "6xx (charge concernée)",
              "credit": "401:NOM_FOURNISSEUR"
            },
            {
              "evenement": "Paiement de la facture",
              "debit": "401:NOM_FOURNISSEUR",
              "credit": "5xx (banque)"
            }
          ]
        },
        {
          "compte": "451",
          "intitule": "Copropriétaires — provisions appelées et versements",
          "usage": "Compte principal des copropriétaires. Sous-compte obligatoire : 451:NOM. Solde débiteur = doit payer. Solde créditeur = trop-versé.",
          "ecritures": [
            {
              "evenement": "Émission d'un appel de fonds courant",
              "debit": "451:NOM",
              "credit": "701"
            },
            {
              "evenement": "Paiement reçu du copropriétaire",
              "debit": "5xx (banque)",
              "credit": "451:NOM"
            }
          ]
        },
        {
          "compte": "452",
          "intitule": "Copropriétaires — avances hors appels ordinaires",
          "usage": "Avances ponctuelles hors budget (travaux urgents non encore votés). Distinct de 451.",
          "ecritures": [
            {
              "evenement": "Demande d'avance au copropriétaire",
              "debit": "452:NOM",
              "credit": "702"
            },
            {
              "evenement": "Encaissement de l'avance",
              "debit": "5xx (banque)",
              "credit": "452:NOM"
            }
          ]
        },
