{
  "id": "rule_0008_contexte_communicator",
  "type": "Rule",
  "title": "Contexte Communicator — module compta copropriété",
  "description": "Contexte d'interprétation du langage naturel pour le module comptabilité de copropriété. Permet au Communicator de classifier correctement les messages et de router les requêtes vers les bons comptes ledger-cli.",
  "creator": "structory",
